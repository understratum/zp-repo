#!/bin/sh
set -eu
NAME=rsync
SRC="/var/zp/build/$NAME"
DESTDIR="/var/zp/pkg/$NAME"
cd "$SRC"
# GitHub-archive = git-дерево: configure не сгенерирован
if [ ! -x ./configure ]; then
    if [ -x ./prepare-source ]; then
        ./prepare-source
    else
        autoreconf -fi
    fi
fi
./configure --prefix=/usr
make -j"$(nproc)"
make DESTDIR="$DESTDIR" install
