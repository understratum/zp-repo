#!/bin/sh
set -eu
NAME=rsync
SRC="$ZP_BUILD_DIR/$NAME"
DESTDIR="$ZP_PKG_DIR/$NAME"
# GitHub-archive = git-дерево: configure не сгенерирован
if [ ! -x ./configure ]; then
    if [ -x ./prepare-source ]; then
        ./prepare-source
    else
        autoreconf -fi
    fi
fi
./configure --prefix=/usr
make -j"$ZP_JOBS"
make DESTDIR="$DESTDIR" install
