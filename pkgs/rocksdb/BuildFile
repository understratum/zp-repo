#!/bin/sh
set -eu
cd "$ZP_SRC_DIR"
cmake -S . -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    "-DWITH_TESTS=OFF" \
    "-DWITH_BENCHMARK_TOOLS=OFF" \
    "-DWITH_TOOLS=ON" \
    "-DROCKSDB_BUILD_SHARED=ON"
cmake --build build --parallel "${ZP_JOBS:-$(nproc)}"
DESTDIR="$ZP_DESTDIR" cmake --install build
