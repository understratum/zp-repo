#!/bin/sh
set -eu

NAME=python3
SRC="$ZP_BUILD_DIR/$NAME"
DESTDIR="$ZP_PKG_DIR/$NAME"
JOBS="$(nproc)"


# --enable-optimizations (PGO) удлинняет сборку втрое — включай осознанно
./configure --prefix=/usr \
  --enable-shared \
  --with-ensurepip=install \
  --with-system-ffi \
  --with-system-libmpdec

make -j"$JOBS"
make DESTDIR="$DESTDIR" install
