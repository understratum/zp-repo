#!/bin/sh
set -eu
NAME=kmod
SRC="/var/zp/build/$NAME"
DESTDIR="/var/zp/pkg/$NAME"
cd "$SRC"
# если meson ругнётся на неизвестную опцию — убери её строку
meson setup build --prefix=/usr \
  -Dzlib=enabled -Dxz=enabled \
  -Dzstd=disabled -Dopenssl=disabled \
  -Dman=disabled -Dtest=disabled
ninja -C build
DESTDIR="$DESTDIR" ninja -C build install
