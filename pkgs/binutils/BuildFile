#!/bin/sh
set -eu

NAME=binutils
SRC="$ZP_BUILD_DIR/$NAME"
DESTDIR="$ZP_PKG_DIR/$NAME"
JOBS="$(nproc)"


# ВНИМАНИЕ: --program-suffix обязателен. Без него zp add binutils перезапишет
# хостовые /usr/bin/ld и /usr/bin/as, и zp remove binutils оставит систему
# без линковщика. Для stage-3 бутстрапа суффикс убрать.
mkdir -p b && cd b

../configure --prefix=/usr \
  --enable-64-bit-bfd \
  --disable-nls \
  --with-system-zlib \
  --program-suffix=-2.47

make -j"$JOBS"
make DESTDIR="$DESTDIR" install
