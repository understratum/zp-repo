#!/bin/sh
set -eu

NAME=shadow
SRC="$ZP_BUILD_DIR/$NAME"
DESTDIR="$ZP_PKG_DIR/$NAME"
JOBS="$(nproc)"

cd "$SRC"

./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
  --disable-static --enable-shadowgrp --disable-logind
make -j"$JOBS"
make DESTDIR="$DESTDIR" install

# passwd/su/login обязаны остаться setuid
for f in passwd su login chsh chfn; do
  [ -f "$DESTDIR/usr/bin/$f" ] && chmod u+s "$DESTDIR/usr/bin/$f"
done
