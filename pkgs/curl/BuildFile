#!/bin/sh
set -eu

NAME=curl
SRC="$ZP_BUILD_DIR/$NAME"
DESTDIR="$ZP_PKG_DIR/$NAME"
JOBS="$(nproc)"


./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
  --with-openssl --with-zlib --enable-threaded-resolver --disable-static --without-libpsl
make -j"$JOBS"
make DESTDIR="$DESTDIR" install
