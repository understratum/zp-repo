#!/bin/sh
set -eu

NAME=libarchive
SRC="$ZP_BUILD_DIR/$NAME"
DESTDIR="$ZP_PKG_DIR/$NAME"
JOBS="$(nproc)"


./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
  --with-zlib --with-bz2lib --with-lzma --with-zstd --with-lz4 \
  --without-nettle --without-openssl --disable-static

make -j"$JOBS"
make DESTDIR="$DESTDIR" install
