#!/bin/sh
set -eu

NAME=c-ares
SRC="$ZP_BUILD_DIR/$NAME"
DESTDIR="$ZP_PKG_DIR/$NAME"
JOBS="$(nproc)"


cmake -S . -B build \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX=/usr \
  -DCARES_BUILD_TOOLS=ON \
  -DCARES_STATIC=OFF \
  -DCARES_SHARED=ON

cmake --build build -j"$JOBS"
DESTDIR="$DESTDIR" cmake --install build
