#!/bin/sh
set -eu
cd "$ZP_SRC_DIR"
cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_SHARED_LIBS=ON -DLEVELDB_BUILD_TESTS=OFF -DLEVELDB_BUILD_BENCHMARKS=OFF -DLEVELDB_INSTALL=ON
cmake --build build --parallel "${ZP_JOBS:-$(nproc)}"
DESTDIR="$ZP_DESTDIR" cmake --install build
