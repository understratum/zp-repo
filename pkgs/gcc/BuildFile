#!/bin/sh
set -eu

NAME=gcc
SRC="/var/zp/build/$NAME"
DESTDIR="/var/zp/pkg/$NAME"
JOBS="$(nproc)"

cd "$SRC"

# ВНИМАНИЕ: --program-suffix=-16 ставит /usr/bin/gcc-16 и /usr/bin/g++-16,
# НЕ трогая хостовый gcc. Внутренности версионные (/usr/lib/gcc/<triplet>/16.2.0/),
# поэтому коллизий с хостом нет. Для stage-3 бутстрапа суффикс убрать.
#
# --disable-bootstrap: одна стадия вместо трёх, втрое быстрее.
# Для релизного дистрибутива убрать — тогда gcc пересоберёт сам себя трижды.
mkdir -p b && cd b

../configure --prefix=/usr \
  --libdir=/usr/lib \
  --libexecdir=/usr/libexec \
  --enable-languages=c,c++ \
  --disable-multilib \
  --enable-shared \
  --enable-threads=posix \
  --with-system-zlib \
  --with-zstd \
  --enable-checking=release \
  --disable-bootstrap \
  --program-suffix=-16

make -j"$JOBS"
make DESTDIR="$DESTDIR" install
